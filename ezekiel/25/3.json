    {
      "kind": "invitation",
      "subject": "Mɛn",
      "rationale": "Weleli daɲɛ — Adonay Yawe bɛ Amon denw wele k'u mɛn a kuma."
    },
    {
      "kind": "you",
      "subject": "Amon denw",
      "rationale": "Kuma in bɛ tɛmɛ Amon denw ma k'a da i ye — i y'a fɔ."
    },
    {
      "kind": "crux",
      "subject": "האח",
      "rationale": "Heaci! — mɔgɔ ka dakun-ko ye min bɛ joli jira; bayɛlɛmabaga caman b'a fɔ 'Aha!' walima 'He! he!'."
    },
    {
      "kind": "substitution",
      "subject": "נחל",
      "rationale": "Heburukan fɔcogo ye 'a bɔli ka juguya' ye — a juguyara; a tɛ 'a tigɛ' ye dɔrɔn."
    }
  ],
  "translation": "K'a fɔ Amon denw ma: Mɛn Adonay Yawe ka kuma; cogoya nin ko Adonay Yawe: sabu i y'a fɔ ko heaci! an ka senumayɔrɔ kan, a juguyara sabu; ani Israyel dugukolo kan, a binna sabu; ani Yuda so kan, u taala bandɔgoya la sabu.",
