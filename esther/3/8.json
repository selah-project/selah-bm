    {
      "kind": "you",
      "subject": "masakɛ Ahashuwerosh",
      "rationale": "Hamani bɛ kuma masakɛ ye a yɛrɛ ma — nɔnabila 'i' (i ka masakɛ) bɛ kuma in kɔnɔ."
    },
    {
      "kind": "crux",
      "subject": "שוה",
      "rationale": "שוה ka kɔrɔ ye 'ka jɛya \/ nɔrɔ' ye — 'a tɛ nɔrɔ masakɛ ye' walima 'masakɛ tɛ yeretaa sɔrɔ' — bayɛlɛmabagaaw bɛ o suguya fila la."
    },
    {
      "kind": "substitution",
      "subject": "dasan",
      "rationale": "שנות ka kɔrɔ ye 'ka yɛlɛma \/ ka dasan' ye — sariya minnu bɛ dasan mɔgɔw bɛɛ sariya la."
    }
  ],
  "translation": "Hamani ko masakɛ Ahashuwerosh ye: mɔgɔ kelen bɛ yen, min bɛ daalan ani u yɛrɛ dasan mɔgɔw kɔnɔ, i ka masakɛ jamana bɛɛ kɔnɔ; ani u ka sariyaw bɛ dasan mɔgɔw bɛɛ sariya la; ⟨את⟩ masakɛ sariyaw, u t'u kɛ; masakɛ ma, a tɛ nɔrɔ ka u bila.",
